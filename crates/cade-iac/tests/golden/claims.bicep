// Generated by CADE from the Architecture canvas. Edits here sync back to the canvas.
param location string = resourceGroup().location

resource appClaimsProd 'Microsoft.Web/sites@2023-12-01' = {
  name: 'app-claims-prod'
  location: location
  identity: { type: 'SystemAssigned' }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    publicNetworkAccess: 'Disabled'
    virtualNetworkSubnetId: vnet::appSubnet.id
    siteConfig: {
      appSettings: [
        { name: 'DB_NAME', value: 'claims' }
      ]
    }
  }
}

resource sqlClaims 'Microsoft.Sql/servers@2023-08-01' = {
  name: 'sql-claims'
  location: location
  properties: {
    publicNetworkAccess: 'Disabled'
    minimalTlsVersion: '1.2'
  }
}

resource sqlClaimsDb 'Microsoft.Sql/servers/databases@2023-08-01' = {
  parent: sqlClaims
  name: 'claims'
  location: location
  sku: { name: 'GP_S_Gen5_2' }
}

resource kvClaims 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'kv-claims'
  location: location
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    publicNetworkAccess: 'Disabled'
  }
}

resource stclaimsphotos 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: 'stclaimsphotos'
  location: location
  kind: 'StorageV2'
  sku: { name: 'Standard_ZRS' }
  properties: {
    allowBlobPublicAccess: false
    minimumTlsVersion: 'TLS1_2'
  }
}


# Golden files and fixtures are compared byte for byte with generated output, which uses LF.
# Without this, Git for Windows checks them out with CRLF and every golden test fails.
crates/*/tests/golden/** text eol=lf
crates/*/tests/fixtures/** text eol=lf
app/ui/src/ipc/bindings.ts text eol=lf
app/ui/src/feedback/forms.generated.ts text eol=lf
app/ui/public/fonts/OFL.txt text eol=lf
app/ui/public/fonts/PROVENANCE.md text eol=lf
